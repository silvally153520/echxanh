# Copy the Supabase Session pooler URI from Project > Connect.
# Use Session mode (port 5432), not Transaction mode (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Copy the Supabase Direct connection URI from Project > Connect.
# If your network cannot reach the direct host, use the Session pooler URI here too.
DIRECT_URL="postgresql://postgres:Ho@ngtn153620@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
PORT=3001
